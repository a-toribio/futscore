# Copia este archivo como `.env.local` y rellena lo que necesites.
# `.env.local` no se sube a git.

# Fuente de datos de la app: `real` (ESPN → API-Football → football-data.org → simulados) o `mock`.
VITE_DATA_SOURCE=real

# Claves de respaldo (opcionales). ESPN no necesita clave.
# Sin prefijo VITE_: solo las lee el proxy de Vite, nunca el navegador.
# https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
# https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
